<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
    <xsd:element name="meteo">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="mesure" maxOccurs="unbounded">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="ville" maxOccurs="unbounded">
                                <xsd:complexType>
                                    <xsd:attribute name="nom" type="xsd:string" use="required"/>
                                    <xsd:attribute name="temperature" type="xsd:int" use="required"/>
                                </xsd:complexType>
                            </xsd:element>
                        </xsd:sequence>
                        <xsd:attribute name="date" type="xsd:date" use="required"/>
                    </xsd:complexType>
                </xsd:element>    
            </xsd:sequence>    
        </xsd:complexType>
    </xsd:element>    
</xs:schema>
